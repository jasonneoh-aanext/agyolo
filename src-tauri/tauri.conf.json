{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Console",
  "version": "1.0.0",
  "identifier": "com.jasonneoh.antigravity.console",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity · Headless PTY Console",
        "width": 1280,
        "height": 860,
        "minWidth": 840,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
